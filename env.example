# Environment variable reference. This file is NOT loaded automatically.
# Local mode needs no variables; defaults to demo accounts and fixtures.
# Set these in your deployment process / service configuration for production.
POOL_ENV=production
POOL_ORIGIN=https://pool.example.com
POOL_DB=/persistent-data/pool.sqlite3
# Generate with: python3 manage.py hash-password
POOL_PASSWORD_HASH=
# Optional normalized licensed feed, never a browser-supplied URL:
NFL_FEED_URL=
NFL_FEED_TOKEN=
